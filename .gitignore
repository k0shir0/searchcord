# Production allowlist: everything else stays local and ignored.
# Add new runtime, deployment, or operating-documentation files explicitly.
# Maintained PR checks are also tracked; scratch checks remain ignored.
*

# Repository metadata and operating documentation
!/.gitattributes
!/.gitignore
!/.dockerignore
!/LICENSE
!/README.md
!/GLOSSARY.md
!/.github/
!/.github/workflows/
!/.github/workflows/pr-tests.yml
!/.github/workflows/rust-parity.yml
!/SEARCHCORD_RUST_MIGRATION_PLAN.md
!/RUST_HANDOFF.md
!/PARITY_LEDGER.md
!/requirements-parity.txt
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/crates/
!/crates/searchcord-archive/
!/crates/searchcord-archive/Cargo.toml
!/crates/searchcord-archive/src/
!/crates/searchcord-archive/src/*.rs
!/crates/searchcord-archive/src/*.sql
!/crates/searchcord-archive/src/*.json
!/crates/searchcord-snapshot/
!/crates/searchcord-snapshot/Cargo.toml
!/crates/searchcord-snapshot/src/
!/crates/searchcord-snapshot/src/*.rs
!/crates/searchcord-snapshot/src/*.sql
!/crates/searchcord-snapshot/tests/
!/crates/searchcord-snapshot/tests/*.rs
!/crates/searchcord-parity/
!/crates/searchcord-parity/Cargo.toml
!/crates/searchcord-parity/src/
!/crates/searchcord-parity/src/*.rs
!/crates/searchcord-parity/src/bin/
!/crates/searchcord-parity/src/bin/*.rs
!/crates/searchcord-parity/tests/
!/crates/searchcord-parity/tests/*.rs
!/crates/searchcord-parity/driver/
!/crates/searchcord-parity/driver/*.py
!/tests/
!/tests/__init__.py
!/tests/durable_fixture.py
!/tests/test_archive_storage.py
!/tests/test_collection_access.py
!/tests/test_collection_queue.mjs
!/tests/test_durable_scrape.py
!/tests/test_scrape_pacing.py
!/tests/test_search_display.py
!/docs/
!/docs/profiles.md
!/docs/search-display.md
!/docs/collection.md
!/docs/archive-reliability.md
!/docs/rust-benchmarks.md
!/docs/benchmarks/
!/docs/benchmarks/*.json

# Application, archive tools, dependencies, and launchers
!/app.py
!/cli.py
!/channel_access.py
!/invite_api.py
!/profile_api.py
