# Production allowlist: everything else stays local and ignored.
# Add new runtime, deployment, or operating-documentation files explicitly.
# Maintained PR checks are also tracked; scratch checks remain ignored.
*

# Repository metadata and operating documentation
!/.gitattributes
!/.gitignore
!/.dockerignore
!/LICENSE
!/README.md
!/GLOSSARY.md
!/.github/
!/.github/workflows/
!/.github/workflows/pr-tests.yml
!/tests/
!/tests/__init__.py
!/tests/durable_fixture.py
!/tests/test_archive_storage.py
!/tests/test_collection_access.py
!/tests/test_collection_queue.mjs
!/tests/test_durable_scrape.py
!/tests/test_scrape_pacing.py
!/tests/test_search_display.py
!/docs/
!/docs/profiles.md
!/docs/search-display.md
!/docs/collection.md
!/docs/archive-reliability.md

# Application, archive tools, dependencies, and launchers
!/app.py
!/cli.py
!/channel_access.py
!/invite_api.py
!/profile_api.py
!/profile_store.py
!/storage.py
!/credential_store.py
!/collection_state.py
!/durable_scrape.py
!/media_store.py
!/chat_export.py
!/search_app.py
!/archive_reader.py
!/snapshot_codec.py
!/search_snapshot.py
!/requirements.txt
!/start.bat
!/start-search.bat
!/run-python.bat

# Production browser assets
!/static/
!/static/app.js
!/static/collection.js
!/static/collection-queue.js
!/static/bauhaus.css
!/static/home.css
!/static/index.html
!/static/profile-view.css
!/static/profile-view.js
!/static/profiles.js
!/static/stats.js
!/static/style.css
!/static/workspace.css
!/static/search/
!/static/search/index.html
!/static/search/privacy.css
!/static/search/privacy.html
!/static/search/search.css
!/static/search/search.js
!/static/brand/
!/static/brand/README.md
!/static/brand/searchcord-logo-dark.png
!/static/brand/searchcord-logo.png
!/static/vendor/
!/static/vendor/chart.LICENSE.md
!/static/vendor/chart.umd.min.js

# Standalone search deployment
!/deploy/
!/deploy/search/
!/deploy/search/Dockerfile
!/deploy/search/Dockerfile.dockerignore
!/deploy/search/README.md
!/deploy/search/package.py
!/deploy/search/requirements.txt
