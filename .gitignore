!/static/
!/static/app.js
!/static/collection.js
!/static/collection-queue.js
!/static/bauhaus.css
!/static/home.css
!/static/index.html
!/static/profile-view.css
!/static/profile-view.js
!/static/profiles.js
!/static/stats.js
!/static/style.css
!/static/workspace.css
