# Build from a standalone folder with a prebuilt Linux static viewer.
FROM scratch
WORKDIR /app
COPY --chmod=0555 searchcord-search /app/searchcord-search
COPY static /app/static
COPY LICENSE THIRD_PARTY_NOTICES.md README.md /app/
USER 65534:65534
EXPOSE 8001
ENTRYPOINT ["/app/searchcord-search"]
CMD ["--host", "0.0.0.0", "--snapshot"]
